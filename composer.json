{
    "name": "souvera/souvera_mail",
    "description": "Souvera Mail — Nextcloud webmail with NC-as-OIDC-Provider",
    "type": "nextcloud-app",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/PhiGi87/souvera_mail",
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "OCA\\SouveraMail\\": "lib/"
        },
        "classmap": [
            "app/smail/v/current/app/libraries/Smail/",
            "lib-bridge/"
        ],
        "files": [
            "lib-bridge/namespace-bridge.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "@php scripts/fix-classmap.php"
        ]
    }
}
